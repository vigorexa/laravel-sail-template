
IMAGE=#CHANGEME - Образ Laravel

APP_DOMAIN=#CHANGEME - Домен приложения

APP_HOST="${APP_DOMAIN}"

POSTGRES_DB=laravel
POSTGRES_USER=#CHANGEME
POSTGRES_PASSWORD=#CHANGEME - Криптостойкий секрет
PGADMIN_HOST="pgadmin.${APP_DOMAIN}"
PGADMIN_DEFAULT_EMAIL=#CHANGEME
PGADMIN_DEFAULT_PASSWORD=#CHANGEME - Криптостойкий секрет

RUSTFS_HOST="s3.${APP_DOMAIN}"
RUSTFS_CONSOLE_HOST="rustfs.${APP_DOMAIN}"
RUSTFS_ACCESS_KEY=#CHANGEME
RUSTFS_SECRET_KEY=#CHANGEME - Криптостойкий секрет
RUSTFS_OBS_ENDPOINT=http://otel-collector:4318
RUSTFS_OBS_SERVICE_NAME=rustfs
RUSTFS_OBS_ENVIRONMENT="${APP_ENV}"
RUSTFS_OBS_METRICS_EXPORT_ENABLED=true
RUSTFS_OBS_LOGS_EXPORT_ENABLED=true
RUSTFS_OBS_TRACES_EXPORT_ENABLED=false

GRAFANA_HOST="grafana.${APP_DOMAIN}"
GF_SECURITY_ADMIN_USER=#CHANGEME
GF_SECURITY_ADMIN_PASSWORD=#CHANGEME - Криптостойкий секрет

TRAEFIK_HOST="traefik.${APP_DOMAIN}"
TRAEFIK_FROWARD_PORT=80

MAILPIT_HOST="mailpit.${APP_DOMAIN}"

APP_NAME=#CHANGEME
APP_SERVICE=laravel
APP_ENV=production
APP_KEY=#CHANGEME - `php artisan key:generate --show`
APP_DEBUG=true
APP_TIMEZONE="Europe/Moscow"
APP_URL="https://${APP_DOMAIN}"

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stdout
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE="${POSTGRES_DB}"
DB_USERNAME="${POSTGRES_USER}"
DB_PASSWORD="${POSTGRES_PASSWORD}"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=keydb
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID="${RUSTFS_ACCESS_KEY}"
AWS_SECRET_ACCESS_KEY="${RUSTFS_SECRET_KEY}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=laravel
AWS_ENDPOINT="https://${RUSTFS_HOST}"
AWS_URL="https://${RUSTFS_HOST}"
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

