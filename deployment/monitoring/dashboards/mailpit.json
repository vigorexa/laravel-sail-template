{
  "uid": "svc-mailpit",
  "title": "Mailpit",
  "tags": ["infrastructure", "mailpit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\", container_label_com_docker_swarm_service_name=~\".*mailpit.*\"}[5m]))",
          "legendFormat": "mailpit"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 2,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor\", container_label_com_docker_swarm_service_name=~\".*mailpit.*\"})",
          "legendFormat": "mailpit"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 3,
      "title": "Network",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{job=\"cadvisor\", container_label_com_docker_swarm_service_name=~\".*mailpit.*\"}[5m]))",
          "legendFormat": "rx"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{job=\"cadvisor\", container_label_com_docker_swarm_service_name=~\".*mailpit.*\"}[5m]))",
          "legendFormat": "tx"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 4,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{stack=\"app_mailpit\"}" }]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
